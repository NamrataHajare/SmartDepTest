{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "out-test",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/report.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "out-test"
  ]
}
