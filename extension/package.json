{
  "name": "smartdeptest-impact",
  "displayName": "SmartDepTest Impact Analysis",
  "description": "Run SmartDepTest dependency impact analysis and inspect selected regression tests.",
  "version": "1.0.0",
  "publisher": "smartdeptest",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:smartdeptest.analyzeProject",
    "onCommand:smartdeptest.runImpactAnalysis",
    "onView:smartdeptest.results"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartdeptest.analyzeProject",
        "title": "SmartDepTest: Analyze Project"
      },
      {
        "command": "smartdeptest.runImpactAnalysis",
        "title": "SmartDepTest: Analyze Dependency Impact",
        "category": "SmartDepTest"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartdeptest",
          "title": "SmartDepTest",
          "icon": "resources/smartdeptest.svg"
        }
      ]
    },
    "views": {
      "smartdeptest": [
        {
          "id": "smartdeptest.results",
          "name": "Analysis Results"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smartdeptest.results",
        "contents": "Run [SmartDepTest: Analyze Project](command:smartdeptest.analyzeProject) to inspect dependency impact and selected regression tests."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "smartdeptest.analyzeProject",
          "when": "explorerResourceIsFolder || resourceFilename == pom.xml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SmartDepTest",
      "properties": {
        "smartdeptest.javaExecutable": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to launch the bundled SmartDepTest analysis engine."
        },
        "smartdeptest.mavenExecutable": {
          "type": "string",
          "default": "mvn",
          "description": "Maven executable used for dependency resolution. Use an absolute path if Maven is not available in VS Code's PATH."
        },
        "smartdeptest.analysisTimeoutMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 120,
          "description": "Maximum time allowed for Maven and SmartDepTest analysis."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./tsconfig.test.json && node --test ./out-test/tests/report.test.js",
    "prepare:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-engine.ps1",
    "vscode:prepublish": "npm run compile && npm run prepare:engine",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.1",
    "typescript": "^5.4.5"
  }
}
